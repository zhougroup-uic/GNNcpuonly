#!/bin/bash
# CPU-only inference with the Greenleaf-lab GNN. Generated by install.sh from run_gnn_infer_cpu.slabmk.in.
# Usage (from YOUR OWN working directory):
#   sbatch @PREFIX@/run_gnn_infer_cpu.slabmk  INPUT_DIR  [OUTPUT_DIR]  [options]
# Outputs and slurm-<id>.out go to the directory you submit from. Options: see USAGE.md (python gnn_predict.py -h).
#SBATCH --job-name=gnncpu_infer
#@SBATCH_EXTRA@
#SBATCH --cpus-per-task=@CPUS@
#SBATCH --mem=@MEM@
#SBATCH -t @TIME@
GNNCPU_HOME=@PREFIX@
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}
unset PYTHONUSERBASE PYTHONPATH
cd "${SLURM_SUBMIT_DIR:-$PWD}"
IN="${1:?usage: sbatch run_gnn_infer_cpu.slabmk INPUT_DIR [OUTPUT_DIR] [gnn_predict.py options]}"; shift
OUT="gnn_pred"; if [ $# -gt 0 ] && [[ "$1" != -* ]]; then OUT="$1"; shift; fi
IN=$(realpath "$IN"); [ -d "$IN" ] || { echo "ERROR: $IN is not a directory"; exit 2; }
hostname
"$GNNCPU_HOME/venv/bin/python" "$GNNCPU_HOME/gnn_predict.py" "$IN" -o "$OUT" "$@"
echo EXIT=$?
